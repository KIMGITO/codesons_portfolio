# =====================================================================
#  CODENSONS PORTFOLIO — ALL YOUR SETTINGS LIVE HERE
#  1) Copy this file to  .env   2) Edit values   3) Restart `npm run dev`
#  Lists: separate items with a comma (,)   |  Fields inside an item: |
#  Images: use a full link (https://...) or a file in /public/images
#          e.g.  /images/profile.jpg
#          Leave an image setting empty and an Unsplash placeholder is used instead.
# =====================================================================

# ---- Identity ----
VITE_NAME="Dennis Kimanthi"
VITE_BRAND="Codensons"
VITE_TAGLINE="I build fast, beautiful web and mobile products that turn visitors into customers."
# Words that type out on the About page (comma separated)
VITE_ROLES="Full-Stack Developer,React & Mobile Engineer,UI/UX Minded Builder,Founder of Codensons"
# Your final public address (no trailing slash). Used for sitemap, canonical links, share cards
VITE_SITE_URL="https://your-domain.com"
# midnight | light | sunset
VITE_DEFAULT_THEME="midnight"

# ---- Personal profile (About page) ----
VITE_AGE="XX"
VITE_LOCATION="Nairobi, Kenya"
VITE_LANGUAGES="English, Kiswahili"
VITE_STATUS="Open for projects"
VITE_ABOUT="I'm a developer from Nairobi who designs and ships complete products, from pixel-perfect React interfaces to offline-first mobile apps and cloud back-ends."
# Education: Title|Institution|Years  ;  next item after a semicolon
VITE_EDUCATION="Your course or degree|Your institution|20XX - 20XX;Certificates / bootcamps|Institution|20XX"

# ---- Company (Company page) ----
VITE_COMPANY_ABOUT="Codensons is a software studio that helps businesses get online, automate their operations and stand out with modern, reliable digital products."
VITE_MISSION="To make great software accessible to every business, big or small."
VITE_VISION="To be the most trusted software partner for growing businesses in Africa and beyond."
VITE_FOUNDED="2024"

# ---- Numbers shown on the Home page ----
VITE_STAT_PROJECTS="10"
VITE_STAT_CLIENTS="8"
VITE_STAT_YEARS="3"

# ---- Philosophy page ----
VITE_PHILOSOPHY_QUOTE="Build things that make people's lives simpler, and do it with integrity."

# ---- Images ----
# VITE_PROFILE_IMAGE=""   # leave empty to use the built-in Unsplash placeholders
# Hero carousel backgrounds (comma separated). Leave empty for gradients.
# VITE_HERO_IMAGES=""   # leave empty to use the built-in Unsplash placeholders
# Gallery images shown with a lightbox (comma separated)
# VITE_GALLERY_IMAGES=""   # leave empty to use the built-in Unsplash placeholders
# Shown on Philosophy page header (optional)
VITE_PHILOSOPHY_IMAGE=""

# ---- Gallery LINKS (Google Photos, Drive, YouTube...) ----
# Format: Title|https://link , Title|https://link
VITE_GALLERY_LINKS="Event photos|https://photos.google.com,My GitHub|https://github.com"

# ---- Contact & social (leave blank to hide a button) ----
VITE_EMAIL="hello@codensons.com"
VITE_PHONE="+254700000000"
# WhatsApp number: country code + number, digits only
VITE_WHATSAPP="254700000000"
# Handles OR full links both work
VITE_INSTAGRAM="codensons"
VITE_FACEBOOK="codensons"
VITE_TWITTER="codensons"
VITE_LINKEDIN=""
VITE_GITHUB=""
VITE_TIKTOK=""
VITE_YOUTUBE=""

# =====================================================================
#  NEW: pricing, trust, availability and tools
# =====================================================================

# ---- Pricing page (sample numbers: set YOUR real starting prices) ----
VITE_CURRENCY="KES"
VITE_PRICE_STARTER="15,000"
VITE_PRICE_BUSINESS="45,000"
# Text shown for the custom package (or a price)
VITE_PRICE_CUSTOM="Let's talk"

# ---- Trust: certificates/awards  Title|Issuer|Year|image (image optional) ; next item ----
# VITE_CERTIFICATES=""   # leave empty to use the built-in Unsplash placeholders
# ---- Clients strip  Name|logo link (logo optional) ; next ----
# VITE_CLIENTS=""   # leave empty to use the built-in Unsplash placeholders

# ---- Availability badge: open | busy ----
VITE_AVAILABILITY_STATUS="open"
VITE_AVAILABILITY_TEXT="Available for new projects"

# ---- Tools (all optional) ----
# Saves quote-form messages. Create a free form at formspree.io and paste its URL
VITE_FORM_ENDPOINT=""
# Cal.com / Calendly link for "Book a free call"
VITE_BOOKING_URL=""
# CV file: put it in public/documents/ (keep the name) or use a link
VITE_CV_URL="/documents/Dennis-Kimanthi-CV.pdf"
# Plausible analytics domain, e.g. codensons.com
VITE_PLAUSIBLE_DOMAIN=""
# Image used when your link is shared on WhatsApp/Facebook (1200x630)
# VITE_OG_IMAGE=""   # leave empty to use the built-in Unsplash placeholders
# Default language: en | sw
VITE_DEFAULT_LANG="en"
# First message when someone taps the floating WhatsApp button
VITE_WHATSAPP_MESSAGE="Hello, I found you on your portfolio and I'd like to talk about a project."

# =====================================================================
#  SEO (see seo/SEO-GUIDE.md)
# =====================================================================
# Home page title (shown on Google, ~60 characters) and description (~155 characters)
VITE_SEO_TITLE="Dennis Kimanthi | Codensons - Web & Mobile App Developer in Nairobi, Kenya"
VITE_SEO_DESCRIPTION="Codensons builds fast, modern websites, web apps and offline-first mobile apps for businesses in Nairobi and across Kenya. Get a free quote today."
